package = razves.sampler.native
# POSIX timers live in librt on the glibc this toolchain links against; without this the link
# fails with undefined timer_create, naming the function and not the library it is in.
linkerOpts.linux = -lrt
---
// THE ONLY CODE RAZVES PUTS INSIDE SOMEBODY ELSE PROCESS, and it is C on purpose.
//
// A signal handler written in Kotlin hangs. Measured, not feared: 3 runs in 10 at 100 Hz and 8 in 10
// at 1 kHz, with two crashes on top, and the failures stop entirely when the sampled workload stops
// allocating - the handler deadlocks against the allocator it interrupted. It is not the body of the
// handler: one that only increments an atomic fails just as often, because what is unsafe is
// entering the Kotlin runtime from a signal at all. See docs/research/research-profiler.md 1.1.
//
// So nothing below touches Kotlin, allocates, takes a lock, or calls anything that is not on the
// async-signal-safe list. What it does is write one stack into a fixed ring and advance a counter.

#ifdef __APPLE__
// macOS hides ucontext_t behind _XOPEN_SOURCE, and hides the deprecation warning behind another one.
#define _XOPEN_SOURCE 700
#define _DARWIN_C_SOURCE 1
#include <mach-o/dyld.h>
#else
#define _GNU_SOURCE 1
#include <time.h>
#endif

#include <signal.h>
#include <sys/time.h>
#include <ucontext.h>
#include <stdint.h>
#include <string.h>
#include <execinfo.h>

#define RAZVES_SLOTS 4096
#define RAZVES_DEPTH 64

// One sample: how many frames were captured, then the frames, leaf first.
static volatile uint32_t razves_depth[RAZVES_SLOTS];
static volatile uint64_t razves_frames[RAZVES_SLOTS][RAZVES_DEPTH];

// Written only by the handler, read only after it is stopped. `taken` counts every signal delivered
// and `dropped` every sample the reader had not consumed - a profile that lost samples has to say
// so rather than look complete.
static volatile uint64_t razves_taken = 0;
static volatile uint64_t razves_dropped = 0;
static volatile uint64_t razves_read = 0;

#ifndef __APPLE__
// A POSIX timer handle, and only where POSIX timers exist. On Apple the type itself is absent, which
// is a sharper way of saying the same thing the research measured: timer_create is not there.
static timer_t razves_timer;
#endif
static int razves_armed = 0;

// THE LEAF IS THE INTERRUPTED INSTRUCTION, NOT THE HANDLER.
//
// backtrace() is called from inside the signal handler, so its frame 0 is this function and its
// frame 1 is the kernel trampoline that called it. Written naively, every sample in every profile
// therefore has the same leaf - and razves duly reported one C function as 100% of the time, which
// is how this was found: the first end-to-end run of the live path, on a program whose work is
// entirely Kotlin. Nothing in the unit tests could have seen it, because they hand the aggregation
// stacks a test made up.
//
// The interrupted program counter is in the context the kernel passes here, exact and free. It goes
// in as frame 0, and the walked frames follow from index RAZVES_SKIP - past this handler and past
// the trampoline.
#define RAZVES_SKIP 2

static void razves_handler(int sig, siginfo_t *info, void *ctx) {
    (void) sig;
    (void) info;
    void *buf[RAZVES_DEPTH];
    int n = backtrace(buf, RAZVES_DEPTH);
    uint64_t t = razves_taken;
    if (t - razves_read >= RAZVES_SLOTS) {
        razves_dropped = razves_dropped + 1;
        razves_taken = t + 1;
        return;
    }
    uint32_t slot = (uint32_t) (t % RAZVES_SLOTS);
    uint32_t depth = 0;
    ucontext_t *uc = (ucontext_t *) ctx;
    if (uc != NULL) {
        // THE INTERRUPTED PROGRAM COUNTER, and it is in a different place on every platform.
        // On x86-64 Linux it is a register in an array whose index is REG_RIP - not exported by the
        // Kotlin binding, so the number is written out. On arm64 Apple it is a named field of a
        // struct reached through a pointer.
#ifdef __APPLE__
        razves_frames[slot][depth++] = (uint64_t) uc->uc_mcontext->__ss.__pc;
#else
        razves_frames[slot][depth++] = (uint64_t) uc->uc_mcontext.gregs[16];
#endif
    }
    // And the walked frames may repeat it: on this unwinder buf[RAZVES_SKIP] IS the interrupted
    // function, at the same address the context carries. Dropping the duplicate rather than skipping
    // a fixed three, because the extra frame is a fact about this unwinder and the comparison is
    // free - a profile with a self-recursive edge on every sample is a profile every viewer draws
    // wrongly.
    int from = RAZVES_SKIP;
    if (depth > 0 && from < n && (uint64_t) buf[from] == razves_frames[slot][0]) from++;
    for (int i = from; i < n && depth < RAZVES_DEPTH; i++) {
        razves_frames[slot][depth++] = (uint64_t) buf[i];
    }
    razves_depth[slot] = depth;
    razves_taken = t + 1;
}

// backtrace() is NOT async-signal-safe on its first call, which loads libgcc. Called once here,
// before the timer is armed, so that the first sample cannot deadlock in the dynamic loader.
static void razves_warm(void) {
    void *buf[8];
    backtrace(buf, 8);
}

// clock: 0 = CLOCK_MONOTONIC (wall time - fires whether the thread runs or not, and is the only one
// that exceeds the scheduler tick: 8,204 Hz delivered for 10,000 requested), 1 =
// CLOCK_THREAD_CPUTIME_ID (this thread only while it runs, and capped at about 200 Hz because a CPU
// clock advances on the tick). Research 1.3 measured both.
static int razves_start(int hz, int clock) {
    if (hz <= 0) return -1;
    if (razves_armed) return -2;
    razves_warm();

    struct sigaction sa;
    memset(&sa, 0, sizeof(sa));
    sa.sa_sigaction = razves_handler;
    sa.sa_flags = SA_SIGINFO | SA_RESTART;
    sigemptyset(&sa.sa_mask);
    if (sigaction(SIGPROF, &sa, NULL) != 0) return -3;

#ifdef __APPLE__
    // NO POSIX TIMERS HERE. `timer_create` and `timer_settime` are absent from platform.posix on
    // macos_arm64 and present on linux_x64 - read out of the klib metadata before a line of this was
    // written. What is left is setitimer, whose interval timers are per process: ITIMER_PROF counts
    // CPU time and ITIMER_REAL wall time, which is the same pair of questions the Linux side answers
    // with two clocks.
    //
    // ITIMER_REAL raises SIGALRM rather than SIGPROF, so the handler is installed on both.
    if (clock != 1 && sigaction(SIGALRM, &sa, NULL) != 0) return -6;
    struct itimerval every;
    memset(&every, 0, sizeof(every));
    every.it_interval.tv_usec = 1000000 / hz;
    every.it_value = every.it_interval;
    if (setitimer(clock == 1 ? ITIMER_PROF : ITIMER_REAL, &every, NULL) != 0) return -4;
#else
    struct sigevent sev;
    memset(&sev, 0, sizeof(sev));
    sev.sigev_notify = SIGEV_SIGNAL;
    sev.sigev_signo = SIGPROF;
    clockid_t id = clock == 1 ? CLOCK_THREAD_CPUTIME_ID : CLOCK_MONOTONIC;
    if (timer_create(id, &sev, &razves_timer) != 0) return -4;

    long ns = 1000000000L / hz;
    struct itimerspec its;
    its.it_interval.tv_sec = ns / 1000000000L;
    its.it_interval.tv_nsec = ns % 1000000000L;
    its.it_value = its.it_interval;
    if (timer_settime(razves_timer, 0, &its, NULL) != 0) return -5;
#endif
    razves_armed = 1;
    return 0;
}

// Idempotent: stopping a sampler that was never started is not an error, and stopping twice must not
// delete a timer that is no longer there.
static void razves_stop(void) {
    if (!razves_armed) return;
#ifdef __APPLE__
    struct itimerval off;
    memset(&off, 0, sizeof(off));
    setitimer(ITIMER_PROF, &off, NULL);
    setitimer(ITIMER_REAL, &off, NULL);
    signal(SIGALRM, SIG_IGN);
#else
    struct itimerspec off;
    memset(&off, 0, sizeof(off));
    timer_settime(razves_timer, 0, &off, NULL);
    timer_delete(razves_timer);
#endif
    signal(SIGPROF, SIG_IGN);
    razves_armed = 0;
}

// WHERE THIS IMAGE WAS LOADED, and the two platforms answer differently because they are built
// differently. An Apple executable is MH_PIE, so a sampled address is the link-time one plus a slide
// chosen at load: razves knows the link-time addresses and cannot know the slide, this process knows
// the slide and will not be there when the profile is read, so it travels in the dump. A
// Kotlin/Native Linux executable is ET_EXEC - measured - and nothing moves.
static uint64_t razves_image_slide(void) {
#ifdef __APPLE__
    return (uint64_t) _dyld_get_image_vmaddr_slide(0);
#else
    return 0;
#endif
}

static uint64_t razves_taken_count(void) { return razves_taken; }
static uint64_t razves_dropped_count(void) { return razves_dropped; }
static int razves_is_armed(void) { return razves_armed; }

// Reading is the consumer side of the ring: only what the handler has finished writing, and the read
// cursor is what tells the handler a slot is free again.
static uint32_t razves_depth_at(uint64_t index) { return razves_depth[index % RAZVES_SLOTS]; }
static uint64_t razves_frame_at(uint64_t index, uint32_t frame) {
    return razves_frames[index % RAZVES_SLOTS][frame % RAZVES_DEPTH];
}
static void razves_mark_read(uint64_t upTo) { razves_read = upTo; }
static uint64_t razves_slots(void) { return RAZVES_SLOTS; }
